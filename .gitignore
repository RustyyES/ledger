.DS_Store
.idea/
.vscode/
*.swp

# The book's rendered page is generated from the markdown chapters by
# docs/book/build_html.py. The chapters are the source of truth; committing the
# 266KB render would just create merge conflicts on every edit.
docs/book/ledger-book.html

# results/ IS committed. Those files are the evidence for the claims in the
# README, and a proof nobody can see is an assertion.
