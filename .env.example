# Copy to `.env` and edit. Compose reads it automatically.
# `.env` is gitignored; this file is the documentation of what exists.

# --- source database -------------------------------------------------------
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# --- object store ----------------------------------------------------------
S3_BUCKET=ledger-raw
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- serving ---------------------------------------------------------------
# Comma-separated. Two slots exist so a shared secret can be rotated without a
# window where either the old or the new key is rejected.
METRICS_API_KEYS=dev-key-change-me,rotate-me-next

# --- load generator --------------------------------------------------------
# Orders per minute in live mode. The default is deliberately gentle; the
# backfill provides the volume, and live mode exists to produce a realistic
# trickle of CURRENT data, not to stress-test anything.
LOADGEN_RATE=12

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- alerting (optional) ---------------------------------------------------
# Unset means alerts are logged but not delivered. Deliberately best-effort:
# an unreachable SMTP server must not turn a warning into a second failure.
# LEDGER_ALERT_EMAIL=you@example.com

# --- cloud warehouse (optional, stage 5) -----------------------------------
# Leave unset to stay on DuckDB. Key-pair auth only -- a password in a
# warehouse profile is a credential that cannot be rotated without a deploy.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_ROLE=TRANSFORMER
# SNOWFLAKE_DATABASE=LEDGER
# SNOWFLAKE_WAREHOUSE=TRANSFORMING
